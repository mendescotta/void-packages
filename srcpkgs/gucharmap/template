configure_args="-Db_ndebug=false -Db_lto=false -Dgtk3=true
 $(vopt_if gir '' '-Dgir=false -Dvapi=false') $(vopt_bool gtk_doc docs)
 -Ducd_path=${XBPS_SRCDISTDIR}/${pkgname}-${version}"
